{
  "schemaVersion": 1,
  "maxRequests": 40,
  "maxRequestBytes": 262144,
  "maxResponseBytes": 65536,
  "maxDurationMs": 10000,
  "actors": [
    { "id": "anonymous", "safeAlias": "public", "authSlot": "anonymous", "relationship": "untrusted" },
    { "id": "member", "safeAlias": "member", "authSlot": "primary", "relationship": "authenticated" }
  ],
  "cases": [
    {
      "id": "events-member",
      "label": "Authenticated event stream",
      "kind": "SSE",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/api/events",
      "headers": {},
      "method": "GET",
      "maxEvents": 4,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "messageType": "ready", "minMessages": 1 }
    },
    {
      "id": "graphql-subscription-member",
      "label": "Member notification subscription",
      "kind": "GRAPHQL_SUBSCRIPTION",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "wss://app.example.com/graphql",
      "headers": {},
      "transport": "GRAPHQL_TRANSPORT_WS",
      "operationName": "RouteCairnNotifications",
      "document": "subscription RouteCairnNotifications { notifications { __typename } }",
      "variables": {},
      "maxMessages": 5,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [101], "deniedStatuses": [401, 403], "messageType": "next", "minMessages": 1 }
    },
    {
      "id": "websocket-authorization-state",
      "label": "Message authorization state sequence",
      "kind": "WEBSOCKET_AUTH_STATE_MACHINE",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "wss://app.example.com/socket",
      "headers": {},
      "subprotocols": ["routecairn-contract-v1"],
      "states": [
        { "send": { "type": "authenticate" } },
        { "expectType": "authenticated" },
        { "send": { "type": "read_profile" } },
        { "expectType": "profile", "expectJsonPath": "data.authorized", "equals": true }
      ],
      "maxMessages": 6,
      "readOnly": true,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [101], "deniedStatuses": [401, 403], "minMessages": 2 }
    },
    {
      "id": "graphql-incremental-member",
      "label": "Incremental feed delivery",
      "kind": "GRAPHQL_INCREMENTAL",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/graphql",
      "headers": {},
      "operationName": "RouteCairnFeed",
      "document": "query RouteCairnFeed { feed @stream(initialCount: 1) { id } }",
      "variables": {},
      "maxParts": 8,
      "expectedPaths": ["feed.1"],
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [400, 401, 403], "minMessages": 2 }
    },
    {
      "id": "graphql-persisted-member",
      "label": "Persisted viewer query",
      "kind": "GRAPHQL_PERSISTED_QUERY",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/graphql",
      "headers": {},
      "operationName": "RouteCairnViewer",
      "document": "query RouteCairnViewer { viewer { id } }",
      "variables": {},
      "sha256Hash": "ef3143baecc8ffcc0354561616a05cc61cad15ec832a631b788c56f065b2a209",
      "negotiation": "REGISTER_THEN_HASH",
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [400, 401, 403], "jsonPath": "data.viewer.id", "minMessages": 0 }
    },
    {
      "id": "graphql-federation-service",
      "label": "Federation service contract",
      "kind": "GRAPHQL_FEDERATION",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/graphql",
      "headers": {},
      "operation": "SERVICE_SDL",
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [400, 401, 403], "jsonPath": "data._service.sdl", "minMessages": 0 }
    },
    {
      "id": "grpc-client-stream-member",
      "label": "Client-streaming authorization",
      "kind": "GRPC_CLIENT_STREAM",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/routecairn.Profile/UploadReadOnlyFixture",
      "headers": {},
      "payloadSecretRefs": ["grpc_chunk_one", "grpc_chunk_two"],
      "maxMessages": 2,
      "interMessageDelayMs": 10,
      "readOnly": true,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "minMessages": 1 }
    },
    {
      "id": "webtransport-datagram-member",
      "label": "WebTransport datagram authorization",
      "kind": "WEBTRANSPORT_DATAGRAM",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/webtransport/echo",
      "headers": {},
      "authenticationMode": "DATAGRAM",
      "datagramSecretRefs": ["webtransport_session", "webtransport_ping"],
      "maxDatagrams": 2,
      "readOnly": true,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "minMessages": 1 }
    },
    {
      "id": "compression-boundary-member",
      "label": "Bounded compressed response",
      "kind": "COMPRESSION_BOUNDARY",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/api/profile",
      "headers": {},
      "method": "GET",
      "encoding": "gzip",
      "maxExpandedBytes": 262144,
      "readOnly": true,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "minMessages": 0 }
    },
    {
      "id": "identity-parity-member",
      "label": "Cross-protocol principal parity",
      "kind": "CROSS_PROTOCOL_IDENTITY",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/api/whoami",
      "headers": {},
      "legs": [
        { "protocol": "HTTP1", "url": "https://app.example.com/api/whoami", "method": "GET", "headers": {}, "jsonPath": "subject" },
        { "protocol": "HTTP2", "url": "https://app.example.com/api/whoami", "method": "GET", "headers": {}, "jsonPath": "subject" },
        { "protocol": "HTTP3", "url": "https://app.example.com/api/whoami", "method": "GET", "headers": {}, "jsonPath": "subject" }
      ],
      "readOnly": true,
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "minMessages": 0 }
    },
    {
      "id": "http2-member",
      "label": "HTTP/2 authorization parity",
      "kind": "HTTP2_AUTHORIZATION",
      "actorId": "member",
      "requireVerifiedIdentity": true,
      "url": "https://app.example.com/api/profile",
      "headers": { "accept": "application/json" },
      "method": "GET",
      "expectation": { "decision": "ALLOW", "allowedStatuses": [200], "deniedStatuses": [401, 403], "minMessages": 0 }
    }
  ]
}
