      "authorization": { "mode": "OBSERVE_ONLY", "environment": "TEST" },
      "steps": [
        { "id": "owner", "phase": "CONTROL", "actorId": "owner", "resourceId": "object", "request": { "method": "GET", "urlTemplate": "https://app.example.com/objects/{{SECRET:owner_object_id}}", "secretSource": "account_a" }, "assertions": [{ "kind": "DECISION", "expected": "ALLOW" }] },
        { "id": "foreign", "phase": "VERIFY", "actorId": "foreign", "resourceId": "object", "request": { "method": "GET", "urlTemplate": "https://app.example.com/objects/{{SECRET:owner_object_id}}", "secretSource": "account_a" }, "assertions": [{ "kind": "DECISION", "expected": "DENY" }] }
      ]
    }
