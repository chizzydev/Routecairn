    { "id": "owner", "safeAlias": "owner", "authSlot": "account_a", "relationship": "OWNER", "principalId": "replace-account-a-principal", "tenantId": "replace-tenant-a" },
    { "id": "foreign", "safeAlias": "foreign", "authSlot": "account_b", "relationship": "CROSS_TENANT", "principalId": "replace-account-b-principal", "tenantId": "replace-tenant-b" }
  ],
  "endpoints": [
    { "id": "webhook", "safeAlias": "payment-webhook", "kind": "WEBHOOK", "pathTemplate": "/webhooks/payments", "allowedOrigins": ["https://app.example.com"] },
    { "id": "cron", "safeAlias": "billing-cron", "kind": "CRON", "pathTemplate": "/ops/cron/billing", "allowedOrigins": ["https://app.example.com"], "declaredWorkloadLimit": 2 },
    { "id": "state", "safeAlias": "authoritative-state", "kind": "JOB", "pathTemplate": "/ops/state/{workflow}", "allowedOrigins": ["https://app.example.com"] },
    { "id": "job", "safeAlias": "job-detail", "kind": "JOB", "pathTemplate": "/ops/jobs/{job}", "allowedOrigins": ["https://app.example.com"] },
    { "id": "incident", "safeAlias": "incident-detail", "kind": "INCIDENT", "pathTemplate": "/ops/incidents/{incident}", "allowedOrigins": ["https://app.example.com"] },
    { "id": "health", "safeAlias": "public-health", "kind": "HEALTH", "pathTemplate": "/health", "allowedOrigins": ["https://app.example.com"] },
    { "id": "admin", "safeAlias": "worker-admin", "kind": "ADMIN", "pathTemplate": "/ops/admin/{operation}", "allowedOrigins": ["https://app.example.com"] }
