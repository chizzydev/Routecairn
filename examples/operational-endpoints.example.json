      "steps": [{ "id": "service", "phase": "VERIFY", "actorId": "service", "endpointId": "admin", "request": { "method": "GET", "urlTemplate": "https://app.example.com/ops/admin/workers", "secretSource": "anonymous" }, "assertions": [{ "kind": "DECISION", "expected": "ALLOW" }] }, { "id": "foreign", "phase": "VERIFY", "actorId": "foreign", "endpointId": "admin", "request": { "method": "GET", "urlTemplate": "https://app.example.com/ops/admin/workers", "secretSource": "anonymous" }, "assertions": [{ "kind": "DECISION", "expected": "DENY" }] }]
