{
  "schemaVersion": 1,
  "maxCases": 20,
  "maxStepsPerCase": 8,
  "maxRequests": 40,
  "maxResponseBytes": 65536,
  "actors": [
    { "id": "public", "safeAlias": "public", "authSlot": "anonymous", "relationship": "PUBLIC" },
