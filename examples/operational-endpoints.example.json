      "steps": [{ "id": "owner", "phase": "VERIFY", "actorId": "owner", "endpointId": "incident", "request": { "method": "GET", "urlTemplate": "https://app.example.com/ops/incidents/{{SECRET:incident_id}}", "secretSource": "account_a" }, "assertions": [{ "kind": "DECISION", "expected": "ALLOW" }] }, { "id": "foreign", "phase": "VERIFY", "actorId": "foreign", "endpointId": "incident", "request": { "method": "GET", "urlTemplate": "https://app.example.com/ops/incidents/{{SECRET:incident_id}}", "secretSource": "account_a" }, "assertions": [{ "kind": "DECISION", "expected": "DENY" }] }]
    },
    {
