{
  "version": "1.0.0",
  "entrypoint": "index.mjs",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "description": "Informational browser response hardening review",
  "permissions": {
    "filesystem": "PACKAGE_READ_ONLY",
    "maxMemoryMb": 32,
    "childProcess": false,
    "network": false,
    "maxRuntimeMs": 10000
  },
  "schemaVersion": 1,
  "moduleId": "reference-security-headers",
  "outputLimit": 10,
  "capabilities": {
    "requestBroker": {
      "bodyPreviewBytes": 0,
      "maxRequestBytes": 0,
      "concurrency": 1,
      "maxResponseBytes": 16384,
      "timeoutMs": 3000,
      "methods": [
        "HEAD"
      ],
      "allowNonMutatingPost": false,
      "maxRequests": 1,
      "pathPrefixes": [
        "/"
      ],
      "riskClass": "LOW"
    }
  }
}
