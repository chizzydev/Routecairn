{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routecairn.invalid/schemas/security-review-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "sourceCommit", "reviewerKeyId", "reviewerOrganization", "independence", "startedAt", "completedAt", "expiresAt", "scope", "disposition", "unresolved", "reportSha256", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "sourceCommit": { "pattern": "^[a-f0-9]{40}$" },
    "reviewerKeyId": { "pattern": "^[A-Za-z0-9._-]{3,80}$" },
    "reviewerOrganization": { "type": "string", "minLength": 2, "maxLength": 160 },
    "independence": { "const": "INDEPENDENT_THIRD_PARTY" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string" } },
    "disposition": { "const": "ACCEPTED" },
    "unresolved": { "type": "object", "additionalProperties": false, "required": ["critical", "high", "medium", "low"], "properties": { "critical": { "const": 0 }, "high": { "const": 0 }, "medium": { "type": "integer", "minimum": 0 }, "low": { "type": "integer", "minimum": 0 } } },
    "reportSha256": { "pattern": "^[a-f0-9]{64}$" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
