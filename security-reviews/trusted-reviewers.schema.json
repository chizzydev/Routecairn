{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "organization",
          "independence",
          "active",
          "publicKeyPem"
        ],
        "properties": {
          "keyId": {
            "pattern": "^[A-Za-z0-9._-]{3,80}$",
            "type": "string"
          },
          "organization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "independence": {
            "const": "INDEPENDENT_THIRD_PARTY"
          },
          "active": {
            "type": "boolean"
          },
          "publicKeyPem": {
            "type": "string",
            "minLength": 80
          }
        }
      }
    }
  }
}
