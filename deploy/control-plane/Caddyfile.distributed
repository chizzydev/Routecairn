{$ROUTECAIRN_HOSTNAME} {
  @fleet path /api/remote-agents/enroll /api/remote-agents/worker/*
  handle @fleet {
    reverse_proxy {
      dynamic a {
        name fleet
        port 4711
        refresh 5s
      }
      lb_policy round_robin
    }
  }
  handle {
    reverse_proxy control-plane:4711
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
}
